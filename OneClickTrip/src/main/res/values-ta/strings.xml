<resources>
    <string name="app_name_oneclicktrip" translatable="false">OneClickTrip</string>
    <string name="oneclicktrip_info">OneClickTrip உங்கள் செயற்கை நுண்ணறிவால் இயக்கப்படும் புத்திசாலி பயண திட்டமிடுபவர் ஆகும். உங்கள் கனவுப் பயணத்தை விளக்கவும் அல்லது உள்ளீடு செய்யவும், உடனடியாக போக்குவரத்து விருப்பங்கள், ஹோட்டல் இணைப்புகள், பட்ஜெட் மதிப்பீடுகள் மற்றும் உள்ளூர் ஆலோசனைகளுடன் தனிப்பயனாக்கப்பட்ட நாள் தினச் சுற்றுலா திட்டத்தைப் பெறுங்கள் — இவை அனைத்தும் ஒரு கிளிக்கில்.</string>

